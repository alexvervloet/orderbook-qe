{
  "name": "orderbook-qe",
  "version": "0.1.0",
  "description": "A quality engineering system built from zero for an onchain order-book exchange",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint spec qe sut",
    "start": "node --experimental-strip-types sut/backend/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run qe/suites/unit",
    "test:property": "vitest run qe/suites/property",
    "test:contract": "vitest run qe/suites/contract",
    "test:consistency": "vitest run qe/suites/consistency",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "check:no-skips": "node --experimental-strip-types qe/tools/no-skips.ts",
    "mutate": "node --experimental-strip-types qe/mutation/run.ts",
    "flake:detect": "node --experimental-strip-types qe/tools/flake.ts",
    "ci:timings": "node --experimental-strip-types qe/tools/timings.ts",
    "select": "node --experimental-strip-types qe/select/affected.ts",
    "ai:triage": "node --experimental-strip-types qe/ai/triage.ts",
    "ai:generate": "node --experimental-strip-types qe/ai/generate.ts",
    "test:integration": "vitest run qe/suites/integration",
    "test:chaos": "vitest run qe/suites/chaos",
    "test:corpus": "vitest run qe/suites/property/corpus.test.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.4.0",
    "oxlint": "^1.82.0",
    "typescript": "^5.9.3",
    "viem": "^2.56.8",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
