{
  "name": "orderbook-qe",
  "version": "0.1.0",
  "description": "A quality engineering system built from zero for an onchain order-book exchange",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint qe sut",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run qe/suites/unit",
    "test:property": "vitest run qe/suites/property",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.4.0",
    "oxlint": "^1.82.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
